# Single ignore file for the whole repo (backend, frontend, kestrel-pay).

# Secrets: keep only the templates
.env
.env.*
!.env.example
*.pem

# Python (backend)
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# Node / Next.js (frontend)
node_modules/
.next/
out/
build/
coverage/
.vercel/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local data
data/
*.rdb

# Tooling
.code-review-graph/

# OS / editors
.DS_Store
.idea/
.vscode/

# Browser checks (Playwright MCP screenshots and logs)
.playwright-mcp/
