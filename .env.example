# Copy to .env and fill in. Never commit .env.
# Where to get each value: docs/setup-accounts.md

# ── FalkorDB ──────────────────────────────────────────────────────────
# Local dev talks to the docker compose container on localhost.
# Inside docker compose the api service overrides FALKORDB_HOST to "falkordb".
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
PAGERSAGE_GRAPH=pagersage

# ── Claude API ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Per-agent models (defaults shown; see build-plan.md section 2)
# MODEL_TRIAGE=claude-haiku-5-5
# MODEL_INVESTIGATOR=claude-sonnet-5-5
# MODEL_HISTORIAN=claude-sonnet-5-5
# MODEL_RESPONDER=claude-haiku-5-5
# MODEL_SCRIBE=claude-sonnet-5-5
# MODEL_BRAIN=claude-sonnet-5-5
# Set to false to keep agents from running on new incidents (they wait in the graph)
# AGENTS_ENABLED=true

# ── Actions ───────────────────────────────────────────────────────────
DISCORD_WEBHOOK_URL=
# Fine-grained token with Issues: read/write on the demo repo only
GITHUB_TOKEN=
GITHUB_ISSUES_REPO=owner/pagersage-demo

# ── Web ───────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:8000
